[Unit]
Description=Mboni web app (gunicorn)
After=network-online.target

[Service]
WorkingDirectory=%h/srv/mboni
EnvironmentFile=%h/.config/mboni/mboni.env
ExecStart=/usr/bin/python3 -m gunicorn run:app --bind 127.0.0.1:8070 --workers 1 --threads 8 --timeout 60 --access-logfile -
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
